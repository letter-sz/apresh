{
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "name": "project",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "prebuild": "npm run prebuild --workspaces --if-present",
    "pretest": "npm run prebuild --workspaces --if-present",
    "start": "npm start --workspaces --if-present",
    "dev": "npm start --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "storybook": "cd src/app && bun run storybook",
    "wasm": "wasm-pack build --target bundler src/crates/apresh-wasm --out-dir ./pkg",
    "test:wasm": "wasm-pack test --headless --chrome src/crates/apresh-wasm",
    "contract": "dfx canister stop contract && dfx canister delete contract && dfx deploy contract",
    "initial": "bash scripts/initial_deploy.sh"
  },
  "type": "module",
  "workspaces": [
    "src/app"
  ],
  "dependencies": {
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.4.1"
  }
}
