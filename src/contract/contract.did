type ActorBase = record {
  id : principal;
  active_shipments : vec nat64;
  name : text;
  version : ActorVersion;
  shipments_history : vec nat64;
};
type ActorVersion = variant { V1; Invalid };
type Channel = record {
  messages : vec blob;
  host_key : blob;
  guest_keys : vec blob;
};
type PrintableShipment = record {
  id : nat64;
  shipper : text;
  status : ShipmentStatus;
  info : ShipmentInfo;
  name : text;
  created_at : nat64;
  hashed_secret : blob;
  carrier : opt text;
  channel : Channel;
};
type Result = variant { Ok; Err : text };
type Result_1 = variant { Ok : nat64; Err : text };
type Result_2 = variant { Ok : blob; Err : text };
type Result_3 = variant { Ok : Channel; Err : text };
type Shipment = record {
  id : nat64;
  shipper : principal;
  status : ShipmentStatus;
  info : ShipmentInfo;
  name : text;
  created_at : nat64;
  version : ActorVersion;
  hashed_secret : blob;
  carrier : opt principal;
  channel : Channel;
};
type ShipmentInfo = record {
  destination : ShipmentLocation;
  value : nat64;
  source : ShipmentLocation;
  size_category : SizeCategory;
  price : nat64;
};
type ShipmentLocation = record { lat : int32; lng : int32; street : text };
type ShipmentStatus = variant {
  InTransit;
  DeliveryScheduled;
  DeliveryCompleted;
  PickupScheduled;
  Bought;
  Cancelled;
  PickupCompleted;
  Pending;
};
type Shipper = record { id : principal; base : ActorBase };
type SizeCategory = variant {
  Parcel : record { max_height : nat64; max_width : nat64; max_depth : nat64 };
  Envelope;
};
service : () -> {
  addWhitelisted : (principal) -> ();
  add_message : (blob, nat64) -> (Result);
  admin_migrate_out : () -> (
      vec Shipper,
      vec Shipper,
      vec Shipment,
      nat64,
    ) query;
  buyShipment : (opt text, nat64, blob) -> (Result);
  cancel_shipment : (nat64) -> (Result);
  carrier_shipments : () -> (vec PrintableShipment) query;
  createShipment : (opt text, text, blob, blob, ShipmentInfo) -> (Result_1);
  finalizeShipment : (nat64, opt text) -> (Result);
  generateQr : (text, nat64) -> (Result_2) query;
  getTransferFee : () -> (nat64) query;
  is_mainnet : () -> (bool) query;
  listPendingShipments : () -> (vec PrintableShipment) query;
  lockCanister : () -> ();
  migrateCarriers : () -> ();
  migrateShipments : () -> ();
  migrateShippers : () -> ();
  read_channel : (nat64) -> (Result_3) query;
  roles : () -> (bool, bool) query;
  setTransferFee : (nat64) -> ();
  shipment : (nat64) -> (opt PrintableShipment) query;
  shipments : () -> (vec PrintableShipment) query;
  shipper_shipments : () -> (vec PrintableShipment) query;
  unlockCanister : () -> ();
}
